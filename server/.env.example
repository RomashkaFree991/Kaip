# Домен, по которому открывается панель. Без своего домена подойдёт <IP-через-дефисы>.sslip.io
KAIP_DOMAIN='1-2-3-4.sslip.io'
# Пароль для входа (не используй одинарную кавычку)
KAIP_PASSWORD='поменяй-меня'
# Случайная строка для подписи cookie
KAIP_SECRET='сгенерируется install.sh'
# 1 — сайт работает по HTTPS (обычный случай). 0 — только для KAIP_DOMAIN=':80' без шифрования.
KAIP_HTTPS='1'
# Начальное разрешение экрана
KAIP_GEOMETRY='1280x720'
